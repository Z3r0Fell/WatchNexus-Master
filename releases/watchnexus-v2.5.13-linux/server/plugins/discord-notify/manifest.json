{
    "id": "discord-notify",
    "name": "Discord Notifications",
    "description": "Send notifications to Discord channels via webhooks",
    "version": "1.0.0",
    "author": "WatchNexus",
    "plugin_type": "notification_provider",
    "entry_point": "main.DiscordNotifyPlugin",
    "homepage": "https://watchnexus.ca/plugins/discord-notify",
    "repository": "https://github.com/WN-Split/wn-plugin-discord",
    "license": "MIT",
    "min_watchnexus_version": "1.0.0",
    "dependencies": [],
    "settings_schema": {
        "type": "object",
        "properties": {
            "webhook_url": {
                "type": "string",
                "title": "Webhook URL",
                "description": "Discord webhook URL for notifications"
            },
            "username": {
                "type": "string",
                "title": "Bot Username",
                "default": "WatchNexus"
            },
            "avatar_url": {
                "type": "string",
                "title": "Avatar URL",
                "default": ""
            },
            "notify_on_download": {
                "type": "boolean",
                "title": "Notify on Download Complete",
                "default": true
            },
            "notify_on_library": {
                "type": "boolean",
                "title": "Notify on Library Update",
                "default": true
            }
        },
        "required": ["webhook_url"]
    },
    "icon": "📢",
    "tags": ["notification", "discord", "webhook"]
}
