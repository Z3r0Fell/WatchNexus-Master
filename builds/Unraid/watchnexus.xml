<?xml version="1.0"?>
<Container version="2">
  <Name>WatchNexus</Name>
  <Repository>watchnexus/watchnexus:latest</Repository>
  <Registry>https://hub.docker.com/r/watchnexus/watchnexus</Registry>
  <Network>bridge</Network>
  <Shell>bash</Shell>
  <Privileged>false</Privileged>
  <Support>https://github.com/watchnexus/watchnexus/issues</Support>
  <Project>https://github.com/watchnexus/watchnexus</Project>
  <Overview>
    WatchNexus is a unified, self-hosted media pipeline for requesting, acquiring, organizing, and streaming media. 
    
    It replaces the need for Sonarr, Radarr, Prowlarr, qBittorrent, Bazarr, and Jellyfin with a single application.
    
    Features:
    - Media library management
    - Automatic metadata fetching
    - Torrent integration
    - Live TV/IPTV support
    - Podcast and radio streaming
    - Web video playback
  </Overview>
  <Category>MediaApp:Video MediaServer:Video</Category>
  <WebUI>http://[IP]:[PORT:8001]/</WebUI>
  <TemplateURL>https://raw.githubusercontent.com/watchnexus/watchnexus/main/builds/Unraid/watchnexus.xml</TemplateURL>
  <Icon>https://raw.githubusercontent.com/watchnexus/watchnexus/main/assets/icon.png</Icon>
  <ExtraParams/>
  <DateInstalled></DateInstalled>
  <Description>
    Unified media pipeline - request, acquire, organize, and watch all your media from one application.
  </Description>
  <Config Name="Web UI Port" Target="8001" Default="8001" Mode="tcp" Description="WebUI port" Type="Port" Display="always" Required="true" Mask="false">8001</Config>
  <Config Name="AppData" Target="/data" Default="/mnt/user/appdata/watchnexus" Mode="rw" Description="Application data storage" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/watchnexus</Config>
  <Config Name="Movies" Target="/media/movies" Default="/mnt/user/media/movies" Mode="ro" Description="Movies library path" Type="Path" Display="always" Required="false" Mask="false">/mnt/user/media/movies</Config>
  <Config Name="TV Shows" Target="/media/tv" Default="/mnt/user/media/tv" Mode="ro" Description="TV shows library path" Type="Path" Display="always" Required="false" Mask="false">/mnt/user/media/tv</Config>
  <Config Name="Music" Target="/media/music" Default="/mnt/user/media/music" Mode="ro" Description="Music library path" Type="Path" Display="always" Required="false" Mask="false">/mnt/user/media/music</Config>
  <Config Name="Downloads" Target="/downloads" Default="/mnt/user/downloads" Mode="rw" Description="Downloads folder" Type="Path" Display="always" Required="false" Mask="false">/mnt/user/downloads</Config>
  <Config Name="JWT Secret" Target="JWT_SECRET" Default="" Mode="" Description="Secret key for authentication (generate a random string)" Type="Variable" Display="always" Required="true" Mask="true"/>
  <Config Name="TMDB API Key" Target="TMDB_API_KEY" Default="" Mode="" Description="TMDB API key for metadata (get free at themoviedb.org)" Type="Variable" Display="always" Required="false" Mask="true"/>
  <Config Name="Timezone" Target="TZ" Default="America/New_York" Mode="" Description="Timezone" Type="Variable" Display="always" Required="false" Mask="false">America/New_York</Config>
  <Config Name="PUID" Target="PUID" Default="99" Mode="" Description="User ID" Type="Variable" Display="advanced" Required="false" Mask="false">99</Config>
  <Config Name="PGID" Target="PGID" Default="100" Mode="" Description="Group ID" Type="Variable" Display="advanced" Required="false" Mask="false">100</Config>
</Container>
