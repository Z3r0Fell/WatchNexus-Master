# ─────────────────────────────────────────────────────────────
#  WatchNexus .gitignore
# ─────────────────────────────────────────────────────────────

# Secrets & environment
.env
.env.*
!.env.example
**/appsettings.Production.json
**/appsettings.Development.json
**/dp-keys/
**/jwt.key
*.key
*.pem

# Data & runtime
*.db
*.db-shm
*.db-wal
**/data/
/var/lib/watchnexus/

# Test reports (may contain values logged during testing)
test_reports/

# .NET
bin/
obj/
*.user
*.suo
[Dd]ebug/
[Rr]elease/
artifacts/

# Node / React
node_modules/
/src/web/build/
/src/web/coverage/
.eslintcache
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/

# Editors / OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Logs
*.log
src/web/node_modules/.cache/default-development/5.pack
src/web/node_modules/electron/dist/electron
*.env
credentials.json
*.pem
*.key
.credentials
src/web/node_modules/.cache/default-development/0.pack
src/web/node_modules/.cache/default-development/6.pack

# Internal agent/dev notes — keep credentials and memory files out of the public repo
/memory/
/auth_testing.md
src/web/node_modules/.cache/default-development/4.pack
src/web/node_modules/.cache/default-development/1.pack
