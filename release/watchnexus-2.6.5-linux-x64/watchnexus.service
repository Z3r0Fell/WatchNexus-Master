[Unit]
Description=WatchNexus Media Server
After=network.target

[Service]
Type=simple
User=watchnexus
Group=watchnexus
WorkingDirectory=/opt/watchnexus
ExecStart=/opt/watchnexus/WatchNexus.Core
Environment=ASPNETCORE_URLS=http://0.0.0.0:8001
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
