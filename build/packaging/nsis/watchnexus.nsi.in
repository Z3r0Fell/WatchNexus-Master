; ══════════════════════════════════════════════════════════════════════
;  WatchNexus NSIS Installer Template
;  Placeholders are substituted by build-installers.fish via sed:
;    @TIER@ @TIER_TITLE@ @VERSION@ @VENDOR@ @URL@
;    @PAYLOAD_WIN@ @PAYLOAD_WEB@ @STAGE_ROOT@ @OUT_DIR@
; ══════════════════════════════════════════════════════════════════════

Unicode True
SetCompressor /SOLID lzma

!define PRODUCT_NAME      "WatchNexus @TIER_TITLE@"
!define PRODUCT_VERSION   "@VERSION@"
!define PRODUCT_PUBLISHER "@VENDOR@"
!define PRODUCT_WEB_SITE  "@URL@"
!define PRODUCT_TIER      "@TIER@"
!define SERVICE_NAME      "WatchNexusCore"
!define DEFAULT_PORT      "8001"

!define MUI_ABORTWARNING
!define MUI_ICON          "@STAGE_ROOT@/../../build/packaging/resources/watchnexus.ico"
!define MUI_UNICON        "@STAGE_ROOT@/../../build/packaging/resources/watchnexus.ico"

; ── Modern UI 2 ────────────────────────────────────────────────────
!include "MUI2.nsh"

!insertmacro MUI_PAGE_WELCOME
!insertmacro MUI_PAGE_LICENSE "@STAGE_ROOT@/LICENSE.txt"
!insertmacro MUI_PAGE_DIRECTORY
!insertmacro MUI_PAGE_INSTFILES
!insertmacro MUI_PAGE_FINISH

!insertmacro MUI_UNPAGE_CONFIRM
!insertmacro MUI_UNPAGE_INSTFILES

!insertmacro MUI_LANGUAGE "English"

; ── Project metadata ──────────────────────────────────────────────
Name          "${PRODUCT_NAME} ${PRODUCT_VERSION}"
OutFile       "@OUT_DIR@/watchnexus-@TIER@-@VERSION@-windows-x64.exe"
InstallDir    "$PROGRAMFILES64\WatchNexus"
InstallDirRegKey HKLM "Software\WatchNexus" "InstallDir"
RequestExecutionLevel admin
ShowInstDetails show
ShowUnInstDetails show

VIProductVersion "@VERSION@.0"
VIAddVersionKey "ProductName"    "WatchNexus @TIER_TITLE@"
VIAddVersionKey "Comments"       "Self-hosted media server"
VIAddVersionKey "CompanyName"    "${PRODUCT_PUBLISHER}"
VIAddVersionKey "LegalCopyright" "Copyright (c) 2026 ${PRODUCT_PUBLISHER}"
VIAddVersionKey "FileDescription" "WatchNexus @TIER_TITLE@ Installer"
VIAddVersionKey "FileVersion"    "@VERSION@"

; ══════════════════════════════════════════════════════════════════════
;  INSTALL
; ══════════════════════════════════════════════════════════════════════

Section "Core (required)" SecCore
    SectionIn RO
    SetOutPath "$INSTDIR\bin"
    File /r "@PAYLOAD_WIN@\*.*"

    SetOutPath "$INSTDIR\web"
    File /r "@PAYLOAD_WEB@\*.*"

    SetOutPath "$INSTDIR"
    File "@STAGE_ROOT@\tier.json"
    File "@STAGE_ROOT@\LICENSE.txt"
    File "@STAGE_ROOT@\LICENSE.html"
    File "@STAGE_ROOT@\README.md"

    ; Helper script that opens the logs folder (used by Start-menu shortcut)
    FileOpen $0 "$INSTDIR\OpenLogs.cmd" w
    FileWrite $0 "@echo off$\r$\n"
    FileWrite $0 "if not exist $\"%PROGRAMDATA%\WatchNexus\logs$\" mkdir $\"%PROGRAMDATA%\WatchNexus\logs$\"$\r$\n"
    FileWrite $0 "start $\"$\" explorer.exe $\"%PROGRAMDATA%\WatchNexus\logs$\"$\r$\n"
    FileClose $0

    ; Drop tier/version locks for Fortress integrity check
    FileOpen $0 "$INSTDIR\tier.lock" w
    FileWrite $0 "@TIER@"
    FileClose $0
    FileOpen $0 "$INSTDIR\version.lock" w
    FileWrite $0 "@VERSION@"
    FileClose $0

    ; Registry markers (read by Fortress + uninstaller)
    WriteRegStr HKLM "Software\WatchNexus" "InstallDir"  "$INSTDIR"
    WriteRegStr HKLM "Software\WatchNexus" "Tier"        "@TIER@"
    WriteRegStr HKLM "Software\WatchNexus" "Version"     "@VERSION@"
    WriteRegStr HKLM "Software\WatchNexus" "Publisher"   "${PRODUCT_PUBLISHER}"

    ; Add/Remove Programs entry
    WriteRegStr HKLM "Software\Microsoft\Windows\CurrentVersion\Uninstall\WatchNexus" \
        "DisplayName"     "WatchNexus @TIER_TITLE@"
    WriteRegStr HKLM "Software\Microsoft\Windows\CurrentVersion\Uninstall\WatchNexus" \
        "DisplayVersion"  "@VERSION@"
    WriteRegStr HKLM "Software\Microsoft\Windows\CurrentVersion\Uninstall\WatchNexus" \
        "Publisher"       "${PRODUCT_PUBLISHER}"
    WriteRegStr HKLM "Software\Microsoft\Windows\CurrentVersion\Uninstall\WatchNexus" \
        "UninstallString" "$INSTDIR\Uninstall.exe"
    WriteRegStr HKLM "Software\Microsoft\Windows\CurrentVersion\Uninstall\WatchNexus" \
        "URLInfoAbout"    "${PRODUCT_WEB_SITE}"
    WriteRegStr HKLM "Software\Microsoft\Windows\CurrentVersion\Uninstall\WatchNexus" \
        "DisplayIcon"     "$INSTDIR\bin\WatchNexus.Core.exe"
    WriteRegDWORD HKLM "Software\Microsoft\Windows\CurrentVersion\Uninstall\WatchNexus" \
        "NoModify" 1
    WriteRegDWORD HKLM "Software\Microsoft\Windows\CurrentVersion\Uninstall\WatchNexus" \
        "NoRepair" 1

    ; Register the Windows service
    nsExec::ExecToLog 'sc.exe create ${SERVICE_NAME} \
        binPath= "\"$INSTDIR\bin\WatchNexus.Core.exe\" --urls http://0.0.0.0:${DEFAULT_PORT}" \
        start= auto \
        DisplayName= "WatchNexus @TIER_TITLE@"'

    ; Add firewall rule
    nsExec::ExecToLog 'netsh.exe advfirewall firewall add rule \
        name="WatchNexus ${DEFAULT_PORT}" dir=in action=allow \
        protocol=TCP localport=${DEFAULT_PORT}'

    ; Start the service
    nsExec::ExecToLog 'sc.exe start ${SERVICE_NAME}'

    ; Generate uninstaller
    WriteUninstaller "$INSTDIR\Uninstall.exe"

    ; Start-menu shortcuts
    CreateDirectory "$SMPROGRAMS\WatchNexus"
    CreateShortcut "$SMPROGRAMS\WatchNexus\WatchNexus Web UI.lnk" \
        "http://localhost:${DEFAULT_PORT}" \
        "" "$INSTDIR\bin\WatchNexus.Core.exe" 0 \
        SW_SHOWNORMAL "" "Open WatchNexus in your browser"
    CreateShortcut "$SMPROGRAMS\WatchNexus\WatchNexus (Console mode).lnk" \
        "$INSTDIR\bin\WatchNexus.Core.exe" \
        "" "$INSTDIR\bin\WatchNexus.Core.exe" 0 \
        SW_SHOWNORMAL "" "Run WatchNexus in a console window (for troubleshooting)"
    CreateShortcut "$SMPROGRAMS\WatchNexus\WatchNexus Logs Folder.lnk" \
        "$INSTDIR\OpenLogs.cmd" \
        "" "$INSTDIR\bin\WatchNexus.Core.exe" 0 \
        SW_SHOWMINIMIZED "" "Open the WatchNexus log folder"
    CreateShortcut "$SMPROGRAMS\WatchNexus\Uninstall WatchNexus.lnk" \
        "$INSTDIR\Uninstall.exe" \
        "" "$INSTDIR\Uninstall.exe" 0

    ; Desktop shortcut (single shortcut to the web UI)
    CreateShortcut "$DESKTOP\WatchNexus.lnk" \
        "http://localhost:${DEFAULT_PORT}" \
        "" "$INSTDIR\bin\WatchNexus.Core.exe" 0 \
        SW_SHOWNORMAL "" "Open WatchNexus in your browser"
SectionEnd

; ══════════════════════════════════════════════════════════════════════
;  UNINSTALL
; ══════════════════════════════════════════════════════════════════════

Section "Uninstall"
    ; Stop + delete the service
    nsExec::ExecToLog 'sc.exe stop ${SERVICE_NAME}'
    nsExec::ExecToLog 'sc.exe delete ${SERVICE_NAME}'

    ; Remove firewall rule
    nsExec::ExecToLog 'netsh.exe advfirewall firewall delete rule \
        name="WatchNexus ${DEFAULT_PORT}"'

    ; Remove files (keep $INSTDIR\data if it exists — user data)
    Delete   "$INSTDIR\Uninstall.exe"
    Delete   "$INSTDIR\tier.json"
    Delete   "$INSTDIR\tier.lock"
    Delete   "$INSTDIR\version.lock"
    Delete   "$INSTDIR\LICENSE.txt"
    Delete   "$INSTDIR\LICENSE.html"
    Delete   "$INSTDIR\README.md"
    Delete   "$INSTDIR\license.key"
    Delete   "$INSTDIR\OpenLogs.cmd"
    RMDir /r "$INSTDIR\bin"
    RMDir /r "$INSTDIR\web"
    RMDir    "$INSTDIR"

    ; Remove shortcuts
    Delete   "$SMPROGRAMS\WatchNexus\WatchNexus Web UI.lnk"
    Delete   "$SMPROGRAMS\WatchNexus\WatchNexus (Console mode).lnk"
    Delete   "$SMPROGRAMS\WatchNexus\WatchNexus Logs Folder.lnk"
    Delete   "$SMPROGRAMS\WatchNexus\Uninstall WatchNexus.lnk"
    RMDir    "$SMPROGRAMS\WatchNexus"
    Delete   "$DESKTOP\WatchNexus.lnk"

    ; Remove registry keys
    DeleteRegKey HKLM "Software\WatchNexus"
    DeleteRegKey HKLM "Software\Microsoft\Windows\CurrentVersion\Uninstall\WatchNexus"
SectionEnd
