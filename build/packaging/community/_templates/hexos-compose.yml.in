version: "3.8"

# ══════════════════════════════════════════════════════════════════════
#  WatchNexus @TIER_TITLE@ — HexOS deployment manifest
#  ──────────────────────────────────────────────────────────────────
#  HexOS uses Docker compose under the hood. Drop this file into your
#  HexOS stack via the "Add custom stack" interface, or via SSH:
#
#    sudo mkdir -p /opt/stacks/watchnexus-@TIER@
#    sudo cp watchnexus-@TIER@-hexos.yml /opt/stacks/watchnexus-@TIER@/compose.yml
#    cd /opt/stacks/watchnexus-@TIER@ && sudo docker compose up -d
# ══════════════════════════════════════════════════════════════════════

services:
  watchnexus:
    image: watchnexus/watchnexus:@VERSION@-@TIER@
    container_name: watchnexus-@TIER@
    restart: unless-stopped

    networks:
      - hexos-default
      - watchnexus-net

    ports:
      - "8001:8001"

    labels:
      # HexOS dashboard integration
      hexos.title: "WatchNexus @TIER_TITLE@"
      hexos.icon: "https://raw.githubusercontent.com/watchnexus/community-hubs/main/hexos/watchnexus-@TIER@.png"
      hexos.url: "http://{HOST}:8001"
      hexos.category: "Media"
      hexos.tier: "@TIER@"
      # Traefik labels (HexOS ships Traefik for reverse proxying)
      traefik.enable: "true"
      traefik.http.routers.watchnexus.rule: "Host(`watchnexus.{HEXOS_DOMAIN}`)"
      traefik.http.routers.watchnexus.entrypoints: "websecure"
      traefik.http.routers.watchnexus.tls.certresolver: "le"
      traefik.http.services.watchnexus.loadbalancer.server.port: "8001"

    environment:
      WATCHNEXUS_TIER: "@TIER@"
      WATCHNEXUS_DATA_DIR: "/data"
      WATCHNEXUS_PORT: "8001"
      ASPNETCORE_ENVIRONMENT: "Production"
      TZ: "America/Toronto"

    volumes:
      - watchnexus-@TIER@-data:/data
      - /mnt/storage/media:/media:ro
      - /mnt/storage/downloads:/downloads

    healthcheck:
      test: ["CMD", "curl", "-fsS", "http://localhost:8001/api/system/health"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 30s

networks:
  hexos-default:
    external: true
  watchnexus-net:
    driver: bridge

volumes:
  watchnexus-@TIER@-data:
    driver: local
