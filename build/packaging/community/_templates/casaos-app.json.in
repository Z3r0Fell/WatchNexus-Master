{
  "$schema": "https://github.com/IceWhaleTech/CasaOS/raw/main/schema/appstore.v2.json",
  "name": "watchnexus-@TIER@",
  "title": {
    "en_us": "WatchNexus @TIER_TITLE@"
  },
  "tagline": {
    "en_us": "Self-hosted media server replacing Jellyfin + the *arr stack"
  },
  "icon": "https://raw.githubusercontent.com/watchnexus/community-hubs/main/casaos/watchnexus-@TIER@.png",
  "screenshot_link": [
    "https://watchnexus.ca/screenshots/dashboard.png",
    "https://watchnexus.ca/screenshots/library.png",
    "https://watchnexus.ca/screenshots/strudel.png"
  ],
  "thumbnail": "https://raw.githubusercontent.com/watchnexus/community-hubs/main/casaos/watchnexus-@TIER@-thumb.png",
  "category": "Media",
  "tips": {
    "before_install": {
      "en_us": "WatchNexus @TIER_TITLE@ requires a valid @TIER@ tier licence key. Get one at https://watchnexus.ca/pricing — or back the Kickstarter campaign for the lowest pricing."
    }
  },
  "developer": "WatchNexus Media Systems",
  "author": "Auz Larocque",
  "title_color": "#0b1220",
  "language": ["en_us", "fr_ca"],
  "scheme": "http",
  "host": "",
  "port_map": "8001",
  "index": "/",
  "services": {
    "watchnexus": {
      "image": "watchnexus/watchnexus:@VERSION@-@TIER@",
      "command": [],
      "deploy": {
        "restart_policy": {
          "condition": "unless-stopped"
        }
      },
      "ports": [
        {
          "target": "8001",
          "published": "8001",
          "protocol": "tcp"
        }
      ],
      "environment": {
        "WATCHNEXUS_TIER": "@TIER@",
        "WATCHNEXUS_DATA_DIR": "/data",
        "WATCHNEXUS_PORT": "8001",
        "ASPNETCORE_ENVIRONMENT": "Production",
        "TZ": "America/Toronto"
      },
      "volumes": [
        {
          "type": "bind",
          "source": "/DATA/AppData/watchnexus-@TIER@",
          "target": "/data"
        },
        {
          "type": "bind",
          "source": "/DATA/Media",
          "target": "/media",
          "read_only": true
        },
        {
          "type": "bind",
          "source": "/DATA/Downloads",
          "target": "/downloads"
        }
      ],
      "healthcheck": {
        "test": ["CMD", "curl", "-fsS", "http://localhost:8001/api/system/health"],
        "interval": "30s",
        "timeout": "5s",
        "retries": 3,
        "start_period": "30s"
      }
    }
  }
}
