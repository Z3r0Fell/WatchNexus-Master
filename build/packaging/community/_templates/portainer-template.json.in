{
  "version": "2",
  "title": "WatchNexus @TIER_TITLE@",
  "description": "Unified self-hosted media server (@TIER@ tier, v@VERSION@) replacing Jellyfin + the *arr stack.",
  "categories": ["Media", "Video", "Music"],
  "platform": "linux",
  "logo": "https://raw.githubusercontent.com/watchnexus/community-hubs/main/portainer/watchnexus-@TIER@.png",
  "type": 3,
  "name": "watchnexus-@TIER@",
  "repository": {
    "url": "https://github.com/watchnexus/community-hubs",
    "stackfile": "portainer/watchnexus-@TIER@-stack.yml"
  },
  "env": [
    {
      "name": "WATCHNEXUS_TIER",
      "label": "Tier",
      "default": "@TIER@",
      "preset": true
    },
    {
      "name": "WATCHNEXUS_PORT",
      "label": "Web UI port",
      "default": "8001"
    },
    {
      "name": "TZ",
      "label": "Timezone",
      "default": "America/Toronto"
    },
    {
      "name": "MEDIA_PATH",
      "label": "Path to your media library",
      "default": "/srv/media"
    },
    {
      "name": "DOWNLOADS_PATH",
      "label": "Path to your downloads directory",
      "default": "/srv/downloads"
    }
  ],
  "note": "After installation, browse to http://your-server:8001 and enter your @TIER@ tier licence key."
}
