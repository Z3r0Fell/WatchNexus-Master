version: "3.8"

# ══════════════════════════════════════════════════════════════════════
#  WatchNexus @TIER_TITLE@ — Portainer Stack
#  Pair with portainer-template.json — Portainer fetches this file
#  via the repository stackfile field.
# ══════════════════════════════════════════════════════════════════════

services:
  watchnexus:
    image: watchnexus/watchnexus:@VERSION@-@TIER@
    container_name: watchnexus-@TIER@
    restart: unless-stopped

    ports:
      - "${WATCHNEXUS_PORT:-8001}:8001"

    environment:
      WATCHNEXUS_TIER: "${WATCHNEXUS_TIER:-@TIER@}"
      WATCHNEXUS_DATA_DIR: "/data"
      WATCHNEXUS_PORT: "8001"
      ASPNETCORE_ENVIRONMENT: "Production"
      TZ: "${TZ:-America/Toronto}"

    volumes:
      - watchnexus-data:/data
      - "${MEDIA_PATH:-/srv/media}:/media:ro"
      - "${DOWNLOADS_PATH:-/srv/downloads}:/downloads"

    healthcheck:
      test: ["CMD", "curl", "-fsS", "http://localhost:8001/api/system/health"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 30s

volumes:
  watchnexus-data:
    driver: local
