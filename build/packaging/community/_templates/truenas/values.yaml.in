# TrueNAS SCALE values.yaml — WatchNexus @TIER_TITLE@ defaults
# Generated by build-installers.fish; commit to the catalog repo as-is.

image:
  repository: watchnexus/watchnexus
  tag: "@VERSION@-@TIER@"
  pullPolicy: IfNotPresent

service:
  type: NodePort
  ports:
    web:
      enabled: true
      port: 8001
      protocol: TCP
      targetPort: 8001
      nodePort: 36801

env:
  WATCHNEXUS_TIER: "@TIER@"
  WATCHNEXUS_DATA_DIR: "/data"
  WATCHNEXUS_PORT: "8001"
  ASPNETCORE_ENVIRONMENT: "Production"
  TZ: "America/Toronto"

persistence:
  data:
    enabled: true
    type: ixVolume
    datasetName: watchnexus-@TIER@-data
    mountPath: /data
  media:
    enabled: true
    type: hostPath
    hostPath: /mnt/tank/media
    mountPath: /media
    readOnly: true
  downloads:
    enabled: true
    type: hostPath
    hostPath: /mnt/tank/downloads
    mountPath: /downloads

resources:
  limits:
    cpu: 4000m
    memory: 8Gi
  requests:
    cpu: 100m
    memory: 256Mi

securityContext:
  runAsUser: 568
  runAsGroup: 568
  fsGroup: 568
  readOnlyRootFilesystem: false
  capabilities:
    drop: ["ALL"]

probes:
  liveness:
    enabled: true
    path: /api/system/health
    port: 8001
    initialDelaySeconds: 30
  readiness:
    enabled: true
    path: /api/system/health
    port: 8001
