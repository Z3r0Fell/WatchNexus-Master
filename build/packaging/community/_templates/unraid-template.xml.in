<?xml version="1.0"?>
<!--
  WatchNexus @TIER_TITLE@ — Unraid Community Apps template
  Generated by build/build-installers.fish; do not edit by hand.
  See: https://github.com/watchnexus/unraid-templates
-->
<Container version="2">
  <Name>WatchNexus-@TIER_TITLE@</Name>
  <Repository>watchnexus/watchnexus:@VERSION@-@TIER@</Repository>
  <Registry>https://hub.docker.com/r/watchnexus/watchnexus</Registry>
  <Network>bridge</Network>
  <MyIP/>
  <Shell>bash</Shell>
  <Privileged>false</Privileged>
  <Support>https://watchnexus.ca/support</Support>
  <Project>https://watchnexus.ca</Project>
  <Overview>WatchNexus @TIER_TITLE@ — a unified, self-hosted media server that replaces Jellyfin, the *arr stack, Jellyseerr, and more with a single application. @TIER_FEATURES@</Overview>
  <Category>MediaApp:Video MediaApp:Music MediaApp:Photos MediaServer:Video MediaServer:Music MediaServer:Other</Category>
  <WebUI>http://[IP]:[PORT:8001]/</WebUI>
  <TemplateURL>https://raw.githubusercontent.com/watchnexus/unraid-templates/main/watchnexus-@TIER@.xml</TemplateURL>
  <Icon>https://raw.githubusercontent.com/watchnexus/unraid-templates/main/icons/watchnexus-@TIER@.png</Icon>
  <ExtraParams/>
  <PostArgs/>
  <CPUset/>
  <DateInstalled/>
  <DonateText>Support WatchNexus development</DonateText>
  <DonateLink>https://opencollective.com/watchnexus</DonateLink>
  <Description>WatchNexus @TIER_TITLE@ — modular media server, version @VERSION@ (Release To Public). One server replaces Jellyfin + Sonarr + Radarr + Jellyseerr + qBittorrent UI + Tdarr + more. @TIER_FEATURES@&#xD;&#xD;After install, browse to the WebUI and enter your @TIER@ tier licence key on the first-launch screen.</Description>
  <Networking>
    <Mode>bridge</Mode>
    <Publish>
      <Port>
        <HostPort>8001</HostPort>
        <ContainerPort>8001</ContainerPort>
        <Protocol>tcp</Protocol>
      </Port>
    </Publish>
  </Networking>
  <Data>
    <Volume>
      <HostDir>/mnt/user/appdata/watchnexus-@TIER@</HostDir>
      <ContainerDir>/data</ContainerDir>
      <Mode>rw</Mode>
    </Volume>
    <Volume>
      <HostDir>/mnt/user/media</HostDir>
      <ContainerDir>/media</ContainerDir>
      <Mode>ro</Mode>
    </Volume>
    <Volume>
      <HostDir>/mnt/user/downloads</HostDir>
      <ContainerDir>/downloads</ContainerDir>
      <Mode>rw</Mode>
    </Volume>
  </Data>
  <Environment>
    <Variable>
      <Value>@TIER@</Value>
      <Name>WATCHNEXUS_TIER</Name>
      <Mode/>
    </Variable>
    <Variable>
      <Value>/data</Value>
      <Name>WATCHNEXUS_DATA_DIR</Name>
      <Mode/>
    </Variable>
    <Variable>
      <Value>America/Toronto</Value>
      <Name>TZ</Name>
      <Mode/>
    </Variable>
  </Environment>
  <Labels/>
  <Config Name="Web UI Port" Target="8001" Default="8001" Mode="tcp" Description="WatchNexus web UI + API port" Type="Port" Display="always" Required="true" Mask="false">8001</Config>
  <Config Name="App Data" Target="/data" Default="/mnt/user/appdata/watchnexus-@TIER@" Mode="rw" Description="WatchNexus database, settings, thumbnails" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/watchnexus-@TIER@</Config>
  <Config Name="Media Library" Target="/media" Default="/mnt/user/media" Mode="ro" Description="Your media library (read-only)" Type="Path" Display="always" Required="false" Mask="false">/mnt/user/media</Config>
  <Config Name="Downloads" Target="/downloads" Default="/mnt/user/downloads" Mode="rw" Description="Incoming downloads directory" Type="Path" Display="always" Required="false" Mask="false">/mnt/user/downloads</Config>
  <Config Name="Tier" Target="WATCHNEXUS_TIER" Default="@TIER@" Mode="" Description="Licence tier — do not change manually" Type="Variable" Display="always" Required="true" Mask="false">@TIER@</Config>
  <Config Name="Timezone" Target="TZ" Default="America/Toronto" Mode="" Description="Container timezone" Type="Variable" Display="always" Required="false" Mask="false">America/Toronto</Config>
</Container>
