[Unit]
Description=WatchNexus Core
After=network.target
Documentation=https://watchnexus.ca

[Service]
Type=simple
WorkingDirectory=/opt/watchnexus
ExecStart=/opt/watchnexus/bin/WatchNexus.Core --urls http://0.0.0.0:8001
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
KillMode=process
Environment=DOTNET_NOLOGO=1
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=WATCHNEXUS_DATA_DIR=/var/lib/watchnexus
Environment=ASPNETCORE_CONTENTROOT=/opt/watchnexus/bin

[Install]
WantedBy=multi-user.target
