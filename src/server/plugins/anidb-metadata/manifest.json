{
    "id": "anidb-metadata",
    "name": "AniDB Metadata Provider",
    "description": "Fetch anime metadata from AniDB (Anime Database)",
    "version": "1.0.0",
    "author": "WatchNexus",
    "plugin_type": "metadata_provider",
    "entry_point": "main.AniDBMetadataPlugin",
    "homepage": "https://watchnexus.ca/plugins/anidb-metadata",
    "repository": "https://github.com/WN-Split/wn-plugin-anidb",
    "license": "MIT",
    "min_watchnexus_version": "1.0.0",
    "dependencies": [],
    "settings_schema": {
        "type": "object",
        "properties": {
            "client_name": {
                "type": "string",
                "title": "AniDB Client Name",
                "description": "Your registered AniDB client name",
                "default": "watchnexus"
            },
            "client_version": {
                "type": "integer",
                "title": "Client Version",
                "default": 1
            },
            "prefer_romaji": {
                "type": "boolean",
                "title": "Prefer Romaji Titles",
                "description": "Use romanized titles instead of Japanese",
                "default": true
            },
            "include_adult": {
                "type": "boolean",
                "title": "Include Adult Content",
                "default": false
            }
        }
    },
    "icon": "🎌",
    "tags": ["metadata", "anime", "anidb", "japanese"]
}
