<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowMissingPrunePackageData>true</AllowMissingPrunePackageData>
    <WebRoot>..\..\web</WebRoot>
    <!-- Windows-only: embed the WatchNexus icon in WatchNexus.Core.exe so
         shell shortcuts, taskbar, Alt-Tab, and the Add/Remove Programs
         entry all show the brand mark. The path is resolved relative to
         this .csproj (../../../build/packaging/resources/watchnexus.ico). -->
    <ApplicationIcon Condition="$(RuntimeIdentifier.StartsWith('win'))">..\..\..\build\packaging\resources\watchnexus.ico</ApplicationIcon>
    <AssemblyTitle>WatchNexus</AssemblyTitle>
    <Product>WatchNexus</Product>
    <Company>WatchNexus Media Systems</Company>
    <Copyright>Copyright (c) 2026 WatchNexus Media Systems</Copyright>
  </PropertyGroup>

  <!-- Windows: upgrade TFM to net10.0-windows and enable WinForms for system tray icon -->
  <PropertyGroup Condition="$(RuntimeIdentifier.StartsWith('win'))">
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <DefineConstants>$(DefineConstants);WINDOWS_BUILD</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" Version="4.1.0" />
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.5.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.4" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.4" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.4">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.4" />
    <PackageReference Include="Microsoft.IdentityModel.Tokens" Version="8.16.0" />
    <PackageReference Include="Microsoft.OpenApi" Version="2.7.5" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.3" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.1.5" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.16.0" />
    <PackageReference Include="System.ServiceModel.Syndication" Version="10.0.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\shared\WatchNexus.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="WatchNexus.Core.Tests" />
  </ItemGroup>

  <!-- Auto-build frontend on dotnet build/run (dev — uses whatever .env has) -->
  <Target Name="BuildFrontend" BeforeTargets="Build" Condition="!Exists('$(MSBuildProjectDirectory)\..\..\web\build\index.html') AND '$(SkipFrontendBuild)' != 'true'">
    <Message Importance="high" Text="[WatchNexus] Building frontend (src/web)..." />
    <Exec Command="yarn install --frozen-lockfile || yarn install" WorkingDirectory="$(MSBuildProjectDirectory)/../../web" />
    <Exec Command="yarn build" WorkingDirectory="$(MSBuildProjectDirectory)/../../web" />
    <Message Importance="high" Text="[WatchNexus] Frontend build complete." />
  </Target>

  <!-- Publish: rebuild frontend with empty REACT_APP_BACKEND_URL for standalone same-origin mode -->
  <Target Name="PublishFrontendBuild" BeforeTargets="PublishFrontendCopy" Condition="'$(SkipFrontendBuild)' != 'true'">
    <Message Importance="high" Text="[WatchNexus] Rebuilding frontend for standalone release (no REACT_APP_BACKEND_URL)..." />
    <Exec Command="yarn install --frozen-lockfile || yarn install" WorkingDirectory="$(MSBuildProjectDirectory)/../../web" />
    <Exec Command="REACT_APP_BACKEND_URL='' yarn build" WorkingDirectory="$(MSBuildProjectDirectory)/../../web" />
    <Message Importance="high" Text="[WatchNexus] Frontend standalone build complete." />
  </Target>

  <Target Name="PublishFrontendCopy" AfterTargets="Publish">
    <ItemGroup>
      <FrontendFiles Include="$(MSBuildProjectDirectory)/../../web/build/**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(FrontendFiles)" DestinationFolder="$(PublishDir)web/build/%(RecursiveDir)" SkipUnchangedFiles="true" />
  </Target>

  <!-- Copy the modules directory into the publish output so external/DLL modules
       (like Lobster) are available in production installs and update packages. -->
  <Target Name="PublishModulesCopy" AfterTargets="Publish">
    <PropertyGroup>
      <ModulesSource>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../modules'))</ModulesSource>
      <ModulesDest>$(PublishDir)modules</ModulesDest>
    </PropertyGroup>
    <MakeDir Directories="$(ModulesDest)" Condition="!Exists('$(ModulesDest)')" />
    <Exec Command="rsync -av --exclude='bin/' --exclude='obj/' &quot;$(ModulesSource)/&quot; &quot;$(ModulesDest)/&quot;" Condition="Exists('$(ModulesSource)')" />
    <Copy SourceFiles="$(ModulesSource)/lobster/bin/$(Configuration)/net10.0/WatchNexus.Module.Lobster.dll"
          DestinationFolder="$(ModulesDest)/lobster/"
          SkipUnchangedFiles="true"
          Condition="Exists('$(ModulesSource)/lobster/bin/$(Configuration)/net10.0/WatchNexus.Module.Lobster.dll')" />
  </Target>

</Project>
