<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Must be WatchNexus.Module.<module.json "name">.dll — that is the exact file
         ModuleLoader looks for. ($(MSBuildProjectName) already carries the
         "WatchNexus.Module." prefix, which produced WatchNexus.Module.WatchNexus.Module.Template.dll.) -->
    <AssemblyName>WatchNexus.Module.Template</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WatchNexus.Shared" Version="1.0.1" />
  </ItemGroup>

</Project>
