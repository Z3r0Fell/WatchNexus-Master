# WatchNexus Systemd Service Unit
# 
# Install: sudo cp watchnexus.service /etc/systemd/system/
# Enable: sudo systemctl daemon-reload && sudo systemctl enable --now watchnexus
# Logs: sudo journalctl -u watchnexus -f
#
# User/Group: watchnexus (create with: sudo useradd -r -s /bin/false -d /var/lib/watchnexus watchnexus)
# Data Dir: /var/lib/watchnexus (chown -R watchnexus:watchnexus /var/lib/watchnexus)
# Media: /data/media, /data/rips, etc. (chown -R watchnexus:watchnexus /data/media)
#
# For Pro/Ultra tiers, change WATCHNEXUS_TIER and ensure license is activated.
# For GPU transcoding (Ultra), ensure nvidia-container-toolkit is installed and user has access.
#
[Unit]
Description=WatchNexus Media Server
Documentation=https://docs.watchnexus.ca
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
User=watchnexus
Group=watchnexus
WorkingDirectory=/opt/watchnexus
ExecStart=/opt/watchnexus/WatchNexus.Core
Restart=on-failure
RestartSec=5
TimeoutStartSec=60
TimeoutStopSec=30

# Environment
Environment=WATCHNEXUS_TIER=standard
Environment=WATCHNEXUS_PORT=8001
Environment=WATCHNEXUS_DATA_DIR=/var/lib/watchnexus
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=DOTNET_GCServer=1
Environment=DOTNET_GCConcurrent=1
Environment=DOTNET_ThreadPool_MinThreads=100

# Security Hardening
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=~@clock @debug @module @mount @obsolete @privileged @raw-io @reboot @swap
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE

# Read/Write Paths (adjust for your media locations)
ReadWritePaths=/var/lib/watchnexus /data/media /data/rips /data/transcoded /data/offline

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=watchnexus
LogLevelMax=info

# Resource Limits (adjust based on tier)
# MemoryLimit=4G
# CPUQuota=200%

[Install]
WantedBy=multi-user.target