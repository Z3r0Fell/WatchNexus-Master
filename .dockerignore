# Ignore development files
node_modules
.git
.emergent
*.log
tmp/
dist/
test_reports/

# Ignore build artifacts
src/watchnexus/core/bin/
src/watchnexus/core/obj/
src/watchnexus/shared/bin/
src/watchnexus/shared/obj/
frontend/node_modules/
frontend/build/

# Ignore docs/website (not needed in container)
docs/
website/
Alpha/
separated/
memory/

# Ignore release artifacts
stage/
WN_Releases/

# Ignore other
*.md
LICENSE
.env*
yarn-error.log

# Secrets & environment
# NOTE: appsettings.json IS included in the image — it is the fallback config
# and must be present so keys like TMDB_API_KEY and LICENSE_SERVER_URL resolve
# when no env vars are set. Only appsettings.Production.json (real secrets)
# is excluded.
appsettings.Production.json
appsettings.Development.json
**/appsettings.Production.json
**/appsettings.Development.json
dp-keys/
**/dp-keys/
jwt.key
**/jwt.key
private.key
**/private.key
*.db
**/data/
